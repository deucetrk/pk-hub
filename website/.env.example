# Public JWT only; never place a Supabase service-role/secret key in VITE variables.
VITE_PARTNER_INTAKE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/partner-lead-intake
VITE_PARTNER_LEAD_PUBLIC_KEY=YOUR_PUBLIC_ANON_JWT

# Base URL of the separate PK HUB Dealer Portal deployment (no trailing slash)
# Used by Public PK HUB to hand approved Dealers to the Portal while preserving referral attribution.
VITE_DEALER_PORTAL_BASE_URL=https://dealer.pkhub.co
